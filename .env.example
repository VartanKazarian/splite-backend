NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Number of proxy hops to trust for req.ip. 0 locally, 1 behind a single LB.
TRUST_PROXY=0

# Prefer DATABASE_URL in Railway/production.
DATABASE_URL=postgres://splite:splite_dev_password@localhost:5432/splite_db
DB_SSL=false
# Set to true once you pin your provider's CA bundle.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be 32+ characters, and all four must be different values.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
QR_SIGNING_SECRET=replace-with-a-third-long-random-secret
WEBHOOK_SECRET=replace-with-a-fourth-long-random-secret

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=2592000
# Leave unset. A table QR is printed onto furniture and has to keep working;
# revocation is rotating that table's nonce, not waiting for a clock. Set a
# positive number of seconds only for codes that should expire, such as one
# printed on a receipt.
# QR_TTL_SECONDS=
# Idle timeout, not a total lifetime: every authenticated guest request pushes
# it back. Two hours of silence from a table means the diner has gone.
GUEST_SESSION_TTL_SECONDS=7200
# The ceiling a sliding session cannot pass however much it is used.
GUEST_MAX_SESSION_AGE_SECONDS=43200
WEBHOOK_TOLERANCE_SECONDS=300

# Reject requests when Redis is unavailable on /api/v1/auth. Defaults to true
# in production so a cache outage cannot disable brute-force protection.
RATE_LIMIT_FAIL_CLOSED_ON_AUTH=false

# BCV reference rates (USD and EUR, published together). A menu may be priced
# in either to avoid holding bolívares through inflation; settlement is always
# VES, at the rate frozen when the bill is opened.
#
# There is no fallback rate and no default value anywhere in the codebase. If
# no verified rate is available the USD line is omitted and the payment still
# applies. An earlier version defaulted to 36.5 while the live rate was 757,
# so every degraded response understated the total ~20x.
FX_ENABLED=true
# Defaults to https://www.bcv.org.ve/ when unset; override only to point at a
# mirror or a fixture.
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_SOURCE=BCV
FX_CACHE_TTL_SECONDS=900
FX_TIMEOUT_MS=8000
# Reject a rate that moves more than this much from the last known good value.
# A scraped page that changes shape yields a plausible but wrong number, and
# silently repricing every menu is worse than showing no USD line.
FX_MAX_DEVIATION_PCT=5
# How far back the last known in-force rate may be used when BCV cannot be
# reached. BCV publishes on business days, so a long weekend with a holiday
# either side is the widest normal gap. Past this the app declines to open a
# foreign-currency bill rather than price it on a figure that has stopped being
# true.
FX_MAX_FALLBACK_AGE_DAYS=5
FX_MIN_RATE=1
FX_MAX_RATE=1000000000

# Database timeouts. These solve different problems; none replaces another.
#   CONNECTION      how long to wait to obtain a pooled connection
#   STATEMENT       how long one statement may run, cancelled server-side
#   IDLE_IN_TRANSACTION  bounds a transaction that stalls holding row locks
#   PAYMENT_STATEMENT    the payment path's own budget, deliberately larger
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DB_PAYMENT_STATEMENT_TIMEOUT_MS=15000

# Serve /openapi.json and /docs. The spec is the contract frontends and payment
# providers consume; set false to withhold it and distribute it out of band.
DOCS_ENABLED=true

# Logging. JSON to stdout at all times; pipe through `pino-pretty` locally if
# you want it readable. Defaults to debug in development and info in production.
# `silent` is honoured, which the test suite uses.
LOG_LEVEL=

# Seed only; never commit real credentials.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-with-12-plus-character-password
SEED_RESTAURANT_NAME=Splite Demo Restaurant

# --- Self-service onboarding -------------------------------------------------
# Off by default, and the routes are not mounted at all while it is off: the
# public form is the one place a stranger can make us send mail, so it has to be
# switched on deliberately.
#
# The form does NOT create an account. It records a lead and notifies the team,
# who telephone the restaurant and then run `npm run onboarding -- invite <id>`.
#
# In production, turning this on makes MAIL_FROM, APP_BASE_URL,
# ONBOARDING_TEAM_EMAIL and a real MAIL_TRANSPORT mandatory (see
# config.assertProductionConfig). Mail that lands in a log file is a lead
# nobody ever reads.
ONBOARDING_ENABLED=false

# Who at Splite reads the submissions and picks up the phone. The address the
# whole form exists to reach.
ONBOARDING_TEAM_EMAIL=onboarding@example.com

# Where the emailed verification link points -- the frontend, not this API.
APP_BASE_URL=http://localhost:5173

# `log` writes the message, link included, to the logger and sends nothing;
# it is refused in production once onboarding is enabled. `resend` posts to
# api.resend.com. Adding SES or Postmark means adding a function to
# src/services/mailer.js and nothing else.
MAIL_TRANSPORT=log
MAIL_FROM=Splite <onboarding@example.com>
MAIL_API_KEY=
MAIL_TIMEOUT_MS=10000

# How long an invitation link lives, and the trial it grants once used.
ONBOARDING_TOKEN_TTL_SECONDS=172800
TRIAL_DAYS=30

# Retention for `npm run purge`, in days. Set by what still reads the row, not
# by what feels tidy: fx_rates has to outlast an FX outage because the rate
# fallback reads it, and webhook_events_processed has to outlast provider retry
# budgets because it is what stops a redelivery settling a bill twice.
#
# The newest fx_rates row per currency is never deleted whatever its age, so a
# purge cannot leave the fallback with nothing to read.
PURGE_REFRESH_SESSION_DAYS=14
PURGE_FX_RATE_DAYS=180
PURGE_WEBHOOK_DELIVERY_DAYS=90
PURGE_WEBHOOK_EVENT_DAYS=180

# Failed logins counted per account, closing the gap the per-address limiter
# leaves: attempts spread over many addresses at one account.
#
# Generous on purpose. Passwords are created with a twelve character minimum and
# each attempt costs an Argon2id verify, so guessing was never the exposure --
# this is cost control and a detection signal. A tight threshold would instead
# hand anyone who knows an owner's email a way to shut their restaurant out of
# its own till. Nothing here ever becomes a lock that needs a human to lift.
AUTH_MAX_ACCOUNT_FAILURES=20
AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=900

# Encryption for bank API credentials. A key ring, `version:material` comma
# separated, base64 or hex, 32 bytes each:
#
#   PAYMENT_CREDENTIALS_KEYS=1:<base64>,2:<base64>
#   PAYMENT_CREDENTIALS_ACTIVE_KEY_VERSION=2
#
# A ring rather than one key because the interesting moment is not the first
# encryption but the rotation years later: add a version, point the active
# version at it, and re-seal old rows in the background instead of in one
# migration that must not fail.
#
# Read lazily and never asserted at boot -- most deployments never store bank
# credentials, and a missing key must break storing them rather than break
# starting the app. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_CREDENTIALS_KEYS=
PAYMENT_CREDENTIALS_ACTIVE_KEY_VERSION=1

# Encryption for TOTP secrets, in exactly the same format and generated the same
# way. A ring of its own rather than a share of the one above, on purpose: a
# deployment with no bank credentials must still be able to offer a second
# factor, and a leaked payment key must not also be a leaked authentication key.
#
# Empty means enrolment returns 503 rather than storing a secret it cannot
# protect. Existing accounts keep signing in on their passwords.
MFA_SECRET_KEYS=
MFA_ACTIVE_KEY_VERSION=1
# How long the gap between a correct password and the code that completes it may
# be. Long enough to open an authenticator and read six digits; short enough
# that a challenge captured in transit is worthless by the time it is replayed.
MFA_CHALLENGE_TTL_SECONDS=300
# Issued once, when the factor is confirmed. Ten is a sheet of paper.
MFA_RECOVERY_CODE_COUNT=10

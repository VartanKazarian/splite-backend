{
  "name": "splite-backend",
  "version": "2.0.0-contract",
  "description": "Production-oriented backend foundation for Splite bill splitting in Venezuela",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "LOG_LEVEL=silent node --test test/*.test.js",
    "test:integration": "LOG_LEVEL=silent node --test test/integration/*.test.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "secrets": "node scripts/generate-secrets.js",
    "smoke": "node scripts/smoke.js",
    "openapi:dump": "node scripts/dump-openapi.js",
    "openapi:check": "node scripts/dump-openapi.js --check",
    "lint": "find src scripts test -name '*.js' -print0 | xargs -0 -n 1 node --check",
    "check:paths": "node scripts/check-invisible-paths.js",
    "audit": "npm audit --audit-level=high",
    "db:local": "bash scripts/local-services.sh start",
    "db:local:stop": "bash scripts/local-services.sh stop",
    "test:integration:local": "DATABASE_URL=postgres://splite@127.0.0.1:55432/splite_test REDIS_URL=redis://127.0.0.1:56379 DB_SSL=false RUN_INTEGRATION=1 LOG_LEVEL=silent node --test test/integration/*.test.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

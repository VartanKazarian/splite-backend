.env
.env.*
!.env.example
!.env.production.example
logs/
coverage/
.DS_Store
npm-debug.log*
*.pem
*.key
# A public CA certificate is not a secret, and this one has to ship with the
# image or the BCV rate lookup fails TLS verification at runtime. Private keys
# stay excluded by the rules above.
!certs/*.pem
dump.rdb

# Production environment for Railway.
#
# Set these as service variables in the Railway dashboard, not in a file.
# `${{Postgres.DATABASE_URL}}` is Railway's reference syntax: it resolves to
# the other service's value at deploy time, so no credential is ever copied.
#
# Generate the four secrets with `npm run secrets` and paste them in. They are
# never printed by anything else and are not recoverable once set.

NODE_ENV=production

# Railway injects PORT. Do not set it yourself.

# --- required in production; the app refuses to boot without them -----------

# The frontend's real origin. Comma-separated for more than one.
# A wildcard is rejected outright in production.
CORS_ORIGINS=https://your-frontend.example.com

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QR_SIGNING_SECRET=
WEBHOOK_SECRET=

# --- database ---------------------------------------------------------------

DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway's private network (postgres.railway.internal) carries no TLS, and the
# app defaults DB_SSL to true whenever NODE_ENV=production -- which fails to
# connect on the first boot. Keep this false while using the internal URL.
#
# If you switch to the public proxy URL instead, set DB_SSL=true and
# DB_SSL_REJECT_UNAUTHORIZED=false, because Railway's proxy presents a
# certificate for a different hostname.
DB_SSL=false

DB_POOL_MAX=20

# --- redis ------------------------------------------------------------------

REDIS_URL=${{Redis.REDIS_URL}}

# --- proxy ------------------------------------------------------------------

# Railway terminates TLS ahead of the app, so one proxy hop is trusted and
# req.ip reads the real client address rather than the proxy's. Rate limiting
# is keyed on it, so a wrong value here buckets every user together.
TRUST_PROXY=1

# --- exchange rate ----------------------------------------------------------

FX_ENABLED=true
EXCHANGE_RATE_API_URL=https://www.bcv.org.ve/
EXCHANGE_RATE_SOURCE=BCV
FX_CACHE_TTL_SECONDS=900

# Rejects a rate that moves more than this from the last known good one. A
# genuine devaluation beyond 5% needs a human to confirm before it is accepted.
FX_MAX_DEVIATION_PCT=5

# --- operational ------------------------------------------------------------

LOG_LEVEL=info

# Serve /docs and /openapi.json. Keep true while a frontend is being built
# against the contract; turn it off if the API is ever publicly reachable
# without authentication in front of it.
DOCS_ENABLED=true

RATE_LIMIT_FAIL_CLOSED_ON_AUTH=true

# Payments in Venezuela can be slow, so a payment transaction gets a larger
# budget than an ordinary query.
DB_PAYMENT_STATEMENT_TIMEOUT_MS=15000

# --- onboarding and outbound mail -------------------------------------------
#
# The public registration form is not served at all while ONBOARDING_ENABLED is
# false. Turning it on makes the rest of this block mandatory, because a
# verification link that goes nowhere is a registration nobody can finish.
#
# MAIL_TRANSPORT=smtp sends through an ordinary mailbox and needs no domain.
# For Gmail the password is a 16-character APP PASSWORD generated at
# myaccount.google.com -- the account password is rejected over SMTP, and the
# app-password option only appears once 2-Step Verification is on. Treat it like
# a signing secret: it can send mail as that address.
#
# Switching to a verified domain later is this block and no code:
# MAIL_TRANSPORT=resend, MAIL_API_KEY, and SPF/DKIM records on the domain. Note
# that an API sender will NOT send from a gmail.com address, and the service
# refuses to start on that combination rather than fail every send in silence.
#
# ONBOARDING_ENABLED=true
# ONBOARDING_TEAM_EMAIL=splite.ve@gmail.com
# APP_BASE_URL=https://app.example.com
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Splite <splite.ve@gmail.com>
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USER=splite.ve@gmail.com
# MAIL_SMTP_PASSWORD=
#
# Verify it before turning the form on, from the Railway shell:
#
#   npm run onboarding -- test-mail
#
# It sends to ONBOARDING_TEAM_EMAIL through the configured transport, prints why
# it failed if it did, and exits non-zero -- so a wrong app password is found
# here rather than by a restaurant whose application nobody is told about.

# --- first-run seeding only -------------------------------------------------
#
# Creates the first restaurant and its owner. Set these, run the seed once from
# the Railway shell, then remove all four -- there is no reason for a running
# service to hold an owner password in its environment.
#
#   ALLOW_PRODUCTION_SEED=true npm run seed
#
# The seed refuses to run in production without that flag, on the grounds that
# nobody types it by accident. The email is validated against the same rule
# /auth/login uses, so an address the login would reject is refused here rather
# than seeding an account that can never sign in.
#
# ALLOW_PRODUCTION_SEED=true
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
# SEED_RESTAURANT_NAME=
